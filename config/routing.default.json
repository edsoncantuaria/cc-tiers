{
  "maxAttempts": 2,
  "reviewPolicy": "risky",
  "learn": true,
  "budget5h": 80,
  "budget7d": 80,
  "classifier": "haiku",
  "lightPath": true,
  "showCost": false,
  "research": true,
  "specify": true,
  "verify": true,
  "verifyAllow": "npm test, npm run test, node --test, npx tsc, npx eslint, npx vitest, npx jest, npx playwright test, vendor/bin/phpunit, ./vendor/bin/phpunit, vendor/bin/phpstan, ./vendor/bin/phpstan, vendor/bin/phpcs, ./vendor/bin/phpcs, pytest, python -m pytest, go test, cargo test",
  "verifyTimeout": 300,
  "verifyBudget": 600,
  "reviewEvidence": true,
  "effort": {
    "on": true,
    "haiku": [
      "low",
      "medium"
    ],
    "sonnet": [
      "high",
      "xhigh"
    ],
    "opus": [
      "high",
      "xhigh"
    ],
    "conserveCap": "high"
  },
  "prices": {
    "asOf": "2026-10-06",
    "unit": "USD per million tokens, Anthropic API list prices. Cache writes cost 1.25x input (5-minute TTL) or 2x (1-hour TTL).",
    "families": {
      "haiku": "claude-haiku-5-5",
      "sonnet": "claude-sonnet-5-5",
      "opus": "claude-opus-5-5"
    },
    "models": {
      "claude-opus-5-5": {
        "input": 4,
        "output": 20,
        "cacheRead": 0.2
      },
      "claude-opus-5": {
        "input": 5,
        "output": 25,
        "cacheRead": 0.5
      },
      "claude-opus-4-8": {
        "input": 5,
        "output": 25,
        "cacheRead": 0.5
      },
      "claude-opus-4-7": {
        "input": 5,
        "output": 25,
        "cacheRead": 0.5
      },
      "claude-opus-4-6": {
        "input": 5,
        "output": 25,
        "cacheRead": 0.5
      },
      "claude-sonnet-5-5": {
        "input": 2,
        "output": 10,
        "cacheRead": 0.2
      },
      "claude-sonnet-5": {
        "input": 2,
        "output": 10,
        "cacheRead": 0.2
      },
      "claude-sonnet-4-6": {
        "input": 3,
        "output": 15,
        "cacheRead": 0.3
      },
      "claude-haiku-5-5": {
        "input": 0.1,
        "output": 0.5,
        "cacheRead": 0.01
      },
      "claude-haiku-4-5": {
        "input": 1,
        "output": 5,
        "cacheRead": 0.1
      }
    }
  },
  "largeFileBytes": 400000,
  "escalation": [
    "haiku",
    "sonnet",
    "opus"
  ],
  "tiers": {
    "haiku": {
      "model": "haiku",
      "agent": "worker",
      "when": [
        "rename a symbol in one or two files",
        "fix a typo, comment, or string",
        "format, lint, or apply a mechanical codemod",
        "look up where a symbol is defined or who calls it",
        "a simple search that only reports what it finds",
        "a mechanical edit of about 15 lines or fewer in one file"
      ],
      "keywords": [
        "rename",
        "renomear",
        "renomeie",
        "typo",
        "erro de digitacao",
        "reformat",
        "formatar",
        "lint",
        "codemod",
        "docstring",
        "fix a comment",
        "where is",
        "who calls",
        "find usages",
        "look up",
        "lookup",
        "onde fica",
        "quem chama"
      ]
    },
    "sonnet": {
      "model": "sonnet",
      "agent": "implementer",
      "when": [
        "a feature with a clear expected result",
        "a bug fix that stays inside one subsystem",
        "tests for behavior that already exists",
        "a refactor that does not change architecture or public contracts"
      ],
      "complexKeywords": [
        "refactor",
        "refator",
        "architect",
        "arquitet",
        "redesign",
        "rewrite",
        "reescrev",
        "across",
        "throughout",
        "entire",
        "whole codebase",
        "every file",
        "todos os arquivos",
        "codebase",
        "performance",
        "optimiz",
        "otimiz",
        "investigat",
        "investig",
        "debug",
        "depur",
        "root cause",
        "causa raiz",
        "flaky",
        "intermit",
        "memory leak",
        "vazamento"
      ]
    },
    "opus": {
      "model": "opus",
      "agent": "orchestrator",
      "reviewAgent": "reviewer",
      "when": [
        "planning and splitting work into tasks",
        "a task that already used its attempts on Sonnet",
        "cross-cutting work the orchestrator cannot hand off cleanly"
      ],
      "reviewWhen": [
        "authentication, payments, migrations, or data loss",
        "a public API, schema, or persisted contract",
        "concurrency, security, or a change across packages",
        "a large diff, or the implementer is unsure",
        "anything the orchestrator judges non-trivial"
      ],
      "reviewKeywords": [
        "authent",
        "authoriz",
        "oauth",
        "login",
        "password",
        "credential",
        "secret",
        "permission",
        "autentic",
        "autoriz",
        "senha",
        "permiss",
        "payment",
        "billing",
        "invoice",
        "checkout",
        "pagamento",
        "cobranca",
        "fatura",
        "migrat",
        "migrac",
        "schema",
        "esquema",
        "public api",
        "api publica",
        "breaking change",
        "data loss",
        "perda de dados",
        "drop table",
        "security",
        "seguranca",
        "vulnerab",
        "encrypt",
        "criptograf",
        "concurren",
        "concorren",
        "race condition",
        "deadlock",
        "mutex",
        "transaction",
        "transac"
      ]
    }
  }
}
