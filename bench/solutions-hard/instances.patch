diff --git a/src/context.js b/src/context.js
new file mode 100644
index 0000000..49efa08
--- /dev/null
+++ b/src/context.js
@@ -0,0 +1,25 @@
+import { AsyncLocalStorage } from 'node:async_hooks'
+
+const storage = new AsyncLocalStorage()
+const fallback = new Map()
+
+/** The default app's state, for code that runs outside any app call (module load). */
+export const defaultState = fallback
+
+/**
+ * Per-app state. slot(factory) returns a getter for this module's piece of the
+ * app whose function is running (the default app outside createApp), built on
+ * first use. The async context follows awaits, timers, and event listeners.
+ */
+export function slot(factory) {
+  const key = Symbol('slot')
+  return () => {
+    const state = storage.getStore() ?? fallback
+    if (!state.has(key)) state.set(key, factory())
+    return state.get(key)
+  }
+}
+
+export function runIn(state, fn) {
+  return storage.run(state, fn)
+}
