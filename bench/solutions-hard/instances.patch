+++ b/test/instances.test.mjs
@@ -0,0 +1,12 @@
+import assert from 'node:assert/strict'
+import { test } from 'node:test'
+import { createApp } from '../src/index.js'
+
+test('two apps share no data or ids', async () => {
+  const a = createApp()
+  const b = createApp({ secret: 'other' })
+  assert.equal((await a.createUser({ name: 'Ana', email: 'ana@a.test' })).id, 'usr_1')
+  assert.equal((await b.createUser({ name: 'Bia', email: 'bia@b.test' })).id, 'usr_1')
+  assert.equal((await a.getUser('usr_1')).name, 'Ana')
+  assert.throws(() => b.verifyToken(a.signToken({ sub: 'usr_1', role: 'worker' })), { status: 401 })
+})
