 // Letters, digits, dot, dash, underscore; never starting with a dot.
 const NAME = /^[A-Za-z0-9_-][A-Za-z0-9_.-]{0,99}$/
@@ -27,12 +28,24 @@ export async function saveAttachment(shiftId, name, content) {
   return { shiftId: shift.id, name, bytes: data.length }
 }
 
+/**
+ * Serves only what saveAttachment could have written: a real shift, a valid name,
+ * and a regular file opened without following symlinks. Anything else is a 404.
+ */
 export async function readAttachment(shiftId, name) {
-  const file = path.resolve(root(), shiftId, name)
+  const missing = () => new NotFoundError(`no attachment ${name} on ${shiftId}`)
+  if (typeof name !== 'string' || !NAME.test(name)) throw missing()
+  const shift = typeof shiftId === 'string' ? await getShift(shiftId) : null
+  if (!shift) throw missing()
+  let handle
   try {
-    return await readFile(file)
+    handle = await open(path.join(root(), shift.id, name), constants.O_RDONLY | constants.O_NOFOLLOW)
+    if (!(await handle.stat()).isFile()) throw missing()
+    return await handle.readFile()
   } catch (error) {
-    if (error.code === 'ENOENT') throw new NotFoundError(`no attachment ${name} on ${shiftId}`)
+    if (['ENOENT', 'ELOOP', 'ENOTDIR', 'EISDIR'].includes(error.code)) throw missing()
     throw error
+  } finally {
+    await handle?.close()
   }
 }
