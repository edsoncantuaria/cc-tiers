+
+/** A cancelled shift keeps its crew on record, so the event can tell them. */
+export async function cancelShift(id, { reason } = {}) {
+  const shift = await requireShift(id)
+  shift.status = 'cancelled'
+  const saved = await saveShift(shift)
+  await emit('shift.cancelled', { shiftId: shift.id, reason: optionalString(reason, 'reason'), assignees: [...shift.assignees] })
+  return saved
+}
