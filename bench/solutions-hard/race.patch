@@ -0,0 +1,150 @@
+import assert from 'node:assert/strict'
+import { test } from 'node:test'
+import * as app from '../src/index.js'
+
+// Every store call waits this long, so concurrent requests interleave the same way on every run.
+const LATENCIES = [0, 3]
+
+async function setup(latency) {
+  app.reset()
+  const workers = []
+  for (let index = 0; index < 6; index += 1) {
+    workers.push((await app.createUser({ name: `W${index}`, email: `w${index}@shiftboard.test`, zone: 'America/New_York' })).id)
+  }
+  app.configure({ storeLatencyMs: latency })
+  return workers
+}
+
+/** Milliseconds fn takes to settle. */
+async function timed(fn) {
+  const started = performance.now()
+  await fn()
+  return performance.now() - started
+}
+
+test('claims that do not conflict do not wait for each other', async () => {
+  const workers = await setup(20)
+  const shifts = []
+  for (let index = 0; index < 5; index += 1) shifts.push((await shift('09:00', '17:00')).id)
+  const single = await timed(() => app.claimShift(shifts[0], workers[0]))
+  const together = await timed(() => all(shifts.slice(1).map((id, index) => app.claimShift(id, workers[index + 1]))))
+  // One after another would take about 4x single; side by side about 1x.
+  assert.ok(together < single * 2, `4 unrelated claims took ${Math.round(together)} ms, one took ${Math.round(single)} ms`)
+  for (const [index, id] of shifts.entries()) assert.deepEqual((await app.getShift(id)).assignees, [workers[index]])
+})
+
+function shift(from, to, capacity = 1) {
+  return app.createShift({ title: `S ${from}`, start: `2026-03-02T${from}:00-05:00`, end: `2026-03-02T${to}:00-05:00`, zone: 'America/New_York', capacity })
+}
+
+/** Fails instead of hanging when a lock is never released. */
+function within(promise, ms = 3000) {
+  let timer
+  const timeout = new Promise((_, reject) => (timer = setTimeout(() => reject(new Error(`still pending after ${ms} ms`)), ms)))
+  return Promise.race([promise, timeout]).finally(() => clearTimeout(timer))
+}
+
+async function all(promises) {
+  const results = await within(Promise.allSettled(promises))
+  return {
+    ok: results.filter((result) => result.status === 'fulfilled').length,
+    errors: results.filter((result) => result.status === 'rejected').map((result) => result.reason),
+  }
+}
+
+for (const latency of LATENCIES) {
+  test(`two workers race for the last place (latency ${latency})`, async () => {
+    const [a, b] = await setup(latency)
+    const { id } = await shift('09:00', '17:00')
+    const { ok, errors } = await all([app.claimShift(id, a), app.claimShift(id, b)])
+    assert.equal(ok, 1)
+    assert.equal(errors[0]?.status, 409)
+    const saved = await app.getShift(id)
+    assert.equal(saved.assignees.length, 1)
+    assert.equal(saved.status, 'full')
+  })
+
+  test(`a double click books the worker once (latency ${latency})`, async () => {
+    const [a] = await setup(latency)
+    const { id } = await shift('09:00', '17:00', 3)
+    const { ok, errors } = await all([app.claimShift(id, a), app.claimShift(id, a)])
+    assert.equal(ok, 1)
+    assert.equal(errors[0]?.status, 409)
+    assert.deepEqual((await app.getShift(id)).assignees, [a])
+  })
+
+  test(`six workers, three places (latency ${latency})`, async () => {
+    const workers = await setup(latency)
+    const { id } = await shift('09:00', '17:00', 3)
+    let events = 0
+    app.on('shift.claimed', () => void (events += 1))
+    const { ok, errors } = await all(workers.map((worker) => app.claimShift(id, worker)))
+    assert.equal(ok, 3)
+    assert.ok(errors.every((error) => error.status === 409))
+    const saved = await app.getShift(id)
+    assert.equal(new Set(saved.assignees).size, 3)
+    assert.equal(saved.assignees.length, 3)
+    assert.equal(events, 3)
+  })
+
+  test(`claims that fit all succeed (latency ${latency})`, async () => {
+    const [a, b, c] = await setup(latency)
+    const shared = await shift('09:00', '17:00', 2)
+    const other = await shift('09:00', '17:00')
+    const { ok } = await all([app.claimShift(shared.id, a), app.claimShift(shared.id, b), app.claimShift(other.id, c)])
+    assert.equal(ok, 3)
+    assert.deepEqual([...(await app.getShift(shared.id)).assignees].sort(), [a, b].sort())
+    assert.deepEqual((await app.getShift(other.id)).assignees, [c])
+  })
+
+  test(`one worker, two overlapping shifts at once (latency ${latency})`, async () => {
+    const [a] = await setup(latency)
+    const morning = await shift('08:00', '12:00')
+    const noon = await shift('11:00', '15:00')
+    const { ok, errors } = await all([app.claimShift(morning.id, a), app.claimShift(noon.id, a)])
+    assert.equal(ok, 1)
+    assert.equal(errors[0]?.status, 409)
+    const booked = (await app.getShift(morning.id)).assignees.length + (await app.getShift(noon.id)).assignees.length
+    assert.equal(booked, 1)
+  })
+
+  test(`a claim racing a release keeps both (latency ${latency})`, async () => {
+    const [a, b] = await setup(latency)
+    const { id } = await shift('09:00', '17:00', 2)
+    await app.claimShift(id, a)
+    const { ok } = await all([app.releaseShift(id, a), app.claimShift(id, b)])
+    assert.equal(ok, 2)
+    const saved = await app.getShift(id)
+    assert.deepEqual(saved.assignees, [b])
+    assert.equal(saved.status, 'open')
+  })
+
+  test(`a claim racing an edit keeps both (latency ${latency})`, async () => {
+    const [a] = await setup(latency)
+    const { id } = await shift('09:00', '17:00', 3)
+    const { ok } = await all([app.claimShift(id, a), app.updateShift(id, { title: 'Renamed' })])
+    assert.equal(ok, 2)
+    const saved = await app.getShift(id)
+    assert.equal(saved.title, 'Renamed')
+    assert.deepEqual(saved.assignees, [a])
+  })
+
+  test(`a claim racing a swap keeps both (latency ${latency})`, async () => {
+    const [a, b, c] = await setup(latency)
+    const { id } = await shift('09:00', '17:00', 2)
+    await app.claimShift(id, a)
+    const { ok } = await all([app.swapShift(id, a, b), app.claimShift(id, c)])
+    assert.equal(ok, 2)
+    assert.deepEqual([...(await app.getShift(id)).assignees].sort(), [b, c].sort())
+  })
+
+  test(`a failed claim does not block the next one (latency ${latency})`, async () => {
+    const [a, b] = await setup(latency)
+    const { id } = await shift('09:00', '17:00', 2)
+    const { ok, errors } = await all([app.claimShift(id, 'usr_99'), app.claimShift('shf_99', a), app.claimShift(id, a)])
+    assert.equal(ok, 1)
+    assert.deepEqual(errors.map((error) => error.status), [404, 404])
+    await within(app.claimShift(id, b))
+    assert.deepEqual((await app.getShift(id)).assignees, [a, b])
+  })
+}
