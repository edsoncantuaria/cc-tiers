diff --git a/src/lock.js b/src/lock.js
new file mode 100644
index 0000000..7cfc41f
--- /dev/null
+++ b/src/lock.js
@@ -0,0 +1,27 @@
+const tails = new Map()
+
+function acquire(key) {
+  const previous = tails.get(key) || Promise.resolve()
+  let release
+  const mine = new Promise((resolve) => (release = resolve))
+  const tail = previous.then(() => mine)
+  tails.set(key, tail)
+  return previous.then(() => () => {
+    release()
+    if (tails.get(key) === tail) tails.delete(key)
+  })
+}
+
+/**
+ * Runs fn once every earlier holder of any of these keys is done. Keys are taken
+ * in sorted order, so two callers can never wait on each other.
+ */
+export async function withLocks(keys, fn) {
+  const releases = []
+  try {
+    for (const key of [...new Set(keys)].sort()) releases.push(await acquire(key))
+    return await fn()
+  } finally {
+    releases.reverse().forEach((release) => release())
+  }
+}
